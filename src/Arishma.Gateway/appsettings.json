{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "leads": {
        "ClusterId": "leads",
        "Match": {
          "Path": "/leads/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/leads"
          }
        ]
      },
      "verify": {
        "ClusterId": "verify",
        "Match": {
          "Path": "/verify/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/verify"
          }
        ]
      },
      "outreach": {
        "ClusterId": "outreach",
        "Match": {
          "Path": "/outreach/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/outreach"
          }
        ]
      },
      "crm": {
        "ClusterId": "crm",
        "Match": {
          "Path": "/crm/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/crm"
          }
        ]
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/billing"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "leads": {
        "Destinations": {
          "leads": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "verify": {
        "Destinations": {
          "verify": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "outreach": {
        "Destinations": {
          "outreach": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "crm": {
        "Destinations": {
          "crm": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "billing": {
        "Destinations": {
          "billing": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
